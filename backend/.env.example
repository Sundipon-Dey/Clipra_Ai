# Copy this file to .env. Keep any Gemini API key backend-only.
# Keep .env private; it is excluded from Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=300
GEMINI_FILE_MAX_BYTES=2147483648
GEMINI_FILE_POLL_TIMEOUT_SECONDS=600
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_INTERACTION_TIMEOUT_SECONDS=1800
# Optional override; default is backend/secrets/youtube-oauth-client.json.
YOUTUBE_CLIENT_SECRETS_FILE=
# Optional Facebook app credential file override; default is backend/secrets/facebook-app.json.
FACEBOOK_APP_SECRETS_FILE=
# Optional trusted localhost HTTPS certificate and private key for Meta OAuth callback.
FACEBOOK_TLS_CERT_FILE=
FACEBOOK_TLS_KEY_FILE=
# Meta Graph API version used by Facebook publishing; Instagram Reels uses v25.0.
FACEBOOK_GRAPH_API_VERSION=v27.0
# Cloudflare R2 S3-compatible storage used temporarily by Instagram Reels publishing.
# Add a one-day lifecycle rule for the ig-reels/ prefix in the R2 bucket.
R2_ACCOUNT_ID=
R2_BUCKET=clipra-ai
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLIPRA_FRAMING_EXTRACT_TIMEOUT_SECONDS=60
CLIPRA_FRAMING_MAX_FRAME_BYTES=3145728

# Local media workspace configuration
CLIPRA_WORKSPACE_DIR=
CLIPRA_MAX_UPLOAD_BYTES=21474836480
CLIPRA_MAX_FILES_PER_IMPORT=20
CLIPRA_MAX_LAYOUT_IMAGE_BYTES=26214400
CLIPRA_FFPROBE=
CLIPRA_FFMPEG=
CLIPRA_FFPROBE_TIMEOUT_SECONDS=45
CLIPRA_PREVIEW_TIMEOUT_SECONDS=3600
CLIPRA_TRANSCRIPTION_MAX_SECONDS=900
CLIPRA_TRANSCRIPTION_TIMEOUT_SECONDS=3600
CLIPRA_TRANSCRIPTION_MODEL=small.en
